{
  "manifest_version": 3,
  "name": "Norma - Buk PM Assistant",
  "version": "1.0.0",
  "description": "Asistente inteligente de gestión de clientes, sincronización de reuniones y etapas en Monday.com para Buk.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://api.monday.com/*",
    "https://script.google.com/*",
    "https://*.script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.script.googleusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://mail.google.com/*",
    "https://firestore.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content/firebase-service.js",
        "content/monday-service.js",
        "content/drive-folder-service.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*",
        "dashboard.html"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Abrir Norma Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "norma-pm-assistant@extension.local",
      "strict_min_version": "109.0"
    }
  }
}
